# FinRAG environment variables: TEMPLATE ONLY, tanpa rahasia asli.
# Sumber kebenaran: Architecture.md bagian 11.7.
# Lokasi nilai asli:
#   API di Lambda     -> SSM Parameter Store di bawah SSM_PATH (diisi manual, lihat infra/terraform/modules/ssm)
#   Flows di Prefect  -> Prefect Secret block (bukan Lambda, bukan env fungsi)
#   Frontend          -> web/.env.local.example dan env Vercel
#   Lokal (uji)       -> export di shell, bukan berkas .env yang di-commit

# ---------- api (Lambda finrag-api) ----------
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-app.clerk.accounts.dev
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

DATABASE_URL=postgresql://user:password@your-pooler.neon.tech/finrag?sslmode=require

SSM_PATH=/finrag/prod/
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/finrag-chat-jobs
LANDING_BUCKET=finrag-landing-ACCOUNT_ID
MD_DATABASE=finrag
MD_MONTHLY_SECONDS_CAP=28800
MOTHERDUCK_TOKEN_RO=your-motherduck-read-only-token

# Cloudflare AI Gateway (satu-satunya jalur LLM, bagian 6.1)
LLM_BASE_URL=https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_id}/custom-opencode/v1
CF_AIG_TOKEN=your-gateway-auth-token
LLM_API_KEY=
PLANNER_MODEL=custom-opencode/your-model-name
FINAL_MODEL=custom-opencode/your-model-name
FALLBACK_MODEL=your-fallback-model-name
DAILY_LLM_BUDGET_USD=0.50

PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=finrag-text
EMBEDDING_MODEL=multilingual-e5-large
EMBEDDING_DIM=1024
PINECONE_MAX_VECTORS=100000
EMBED_MONTHLY_TOKEN_CAP=4000000

BINANCE_BASE_URL=https://data-api.binance.vision
COINGECKO_API_KEY=

LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://us.cloud.langfuse.com

SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
HANDOFF_WEBHOOK_URL=

# ---------- flows (Prefect Secret block) ----------
AWS_ACCESS_KEY_ID=finrag-prefect-writer key id
AWS_SECRET_ACCESS_KEY=finrag-prefect-writer secret
MOTHERDUCK_TOKEN_RW=your-motherduck-read-write-token
UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
FIRECRAWL_API_KEY=fc-your-firecrawl-key
FIRECRAWL_CREDIT_BUDGET=450
NEWS_RSS_URL=https://www.coindesk.com/arc/outboundfeeds/rss/

# ---------- web (Vercel): lihat web/.env.local.example ----------
# NEXT_PUBLIC_API_URL, NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, NEXT_PUBLIC_CONTACT_URL, CLERK_SECRET_KEY
