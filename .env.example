# FinRAG environment variables — TEMPLATE ONLY, no real secrets.
# Source of truth: Architecture.md section 11.7. Fill real values in:
#   local dev (api/flows) -> session env or an untracked .env
#   Cloud Run prod        -> .env.prod.yaml (gitignored) via gcloud run deploy --env-vars-file
#   Prefect flows         -> Prefect Secret block (UPSTASH_*, GCP_*, FIRECRAWL_*, GCP_SA_KEY_B64)
#   web/ frontend         -> web/.env.local.example / Vercel dashboard

# ---------- api (finrag-api on Cloud Run) ----------
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-app.clerk.accounts.dev
ALLOWED_ORIGINS=https://your-app.vercel.app

DATABASE_URL=postgresql://user:password@your-pooler.neon.tech/finrag?sslmode=require

GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-east1
BQ_DATASET_RAW=finrag_raw
BQ_DATASET_STG=finrag_stg
BQ_DATASET_MART=finrag_mart

CLOUD_TASKS_QUEUE=chat-jobs
SERVICE_URL=https://finrag-api-xxxxxxxxxx.a.run.app
TASKS_INVOKER_SA=sa-tasks-invoker@your-gcp-project-id.iam.gserviceaccount.com

# Cloudflare AI Gateway — single LLM egress (Architecture.md 6.1/14.4)
LLM_BASE_URL=https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_id}/custom-opencode/v1
CF_AIG_TOKEN=your-gateway-auth-token
LLM_API_KEY=your-provider-key-only-if-not-stored-in-cloudflare
PLANNER_MODEL=custom-opencode/your-model-name
FINAL_MODEL=custom-opencode/your-model-name
FALLBACK_MODEL=your-fallback-model-name
DAILY_LLM_BUDGET_USD=0.50

PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=finrag
EMBEDDING_MODEL=multilingual-e5-large
EMBEDDING_DIM=1024
PINECONE_MAX_VECTORS=100000
EMBED_MONTHLY_TOKEN_CAP=4000000

BINANCE_BASE_URL=https://data-api.binance.vision
COINGECKO_API_KEY=optional-coingecko-key

LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://us.cloud.langfuse.com

SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
HANDOFF_WEBHOOK_URL=optional-discord-or-telegram-webhook

# ---------- flows (Prefect, extra `flows`) ----------
UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
FIRECRAWL_API_KEY=fc-your-firecrawl-key
FIRECRAWL_CREDIT_BUDGET=450
NEWS_RSS_URL=https://www.coindesk.com/arc/outboundfeeds/rss/
# base64 of the sa-flows JSON key — Prefect Secret block ONLY, never Cloud Run (Architecture.md 11.7)
GCP_SA_KEY_B64=your-base64-service-account-key

# ---------- web (Vercel) — see web/.env.local.example ----------
# NEXT_PUBLIC_API_URL, NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, NEXT_PUBLIC_CONTACT_URL, CLERK_SECRET_KEY
